# Copy to ignored .env.production and replace placeholders. No passwords here.
# Exact origins; no implicit www or subdomains. Site IDs namespace anonymous quotas.
INTEGRATIONS='[{"origin":"https://example.com","site":"shifter"},{"origin":"https://second.example.com","site":"ip-info"},{"origin":"https://staging.example.com","site":"shifter"}]'
RECAPTCHA_SITE_KEY=replace-with-public-v2-site-key
RECAPTCHA_SECRET_FILE=./.secrets/recaptcha-secret
RUNTIME_HOST=proxy.example.net
PUBLIC_BIND_IP=0.0.0.0
TLS_CERT_DIR=./.secrets/https
REDIS_NETWORK=private-session-state
REDIS_URL_SECRET_FILE=./.secrets/redis-url
REDIS_TLS_DIR=./.secrets/redis-tls
REDIS_CA_FILE=
SHIFTER_CREDENTIALS_FILE=./.secrets/shifter-credentials.toml
SHIFTER_REGION=blr
