# Portable defaults for synthetic tests. This file contains no real credentials.
# Before live mode, set the path to your own private TOML credential file.
SHIFTER_CREDENTIALS_FILE=./tests/fixtures/credentials.toml
SHIFTER_REGION=blr
SESSION_SECONDS=1800
BYTE_LIMIT=104857600
MAX_STREAMS=64
STREAM_RATE=32
STREAM_BURST=64
CONNECT_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=15
